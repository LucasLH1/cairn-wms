# Modèle des variables d'environnement. Aucune valeur réelle ici : les vraies vivent hors du dépôt.

# Rôle du processus serveur : gestures | jobs (fiche 0017).
CAIRN_ROLE=gestures
CAIRN_HOST=0.0.0.0
CAIRN_PORT=3000
CAIRN_VERSION=development

# Base de l'application (fiche 0021). Le rôle de l'application est cairn_app.
CAIRN_DATABASE_HOST=localhost
CAIRN_DATABASE_PORT=5432
CAIRN_DATABASE_NAME=cairn
CAIRN_DATABASE_APP_PASSWORD=a-remplacer

# Migration seulement : l'administrateur amorce les rôles, cairn_owner applique les migrations.
CAIRN_DATABASE_ADMIN_USER=postgres
CAIRN_DATABASE_ADMIN_PASSWORD=a-remplacer
CAIRN_DATABASE_OWNER_PASSWORD=a-remplacer

# Génération des types de la base (pnpm -F @cairn/serveur db:types), sur une base migrée.
CAIRN_DATABASE_ADMIN_URL=postgres://postgres:a-remplacer@localhost:5432/cairn

# Tests : un PostgreSQL jetable ; la base cairn_test y est recréée à chaque lancement.
CAIRN_TEST_DATABASE_HOST=localhost
CAIRN_TEST_DATABASE_PORT=5432
CAIRN_TEST_DATABASE_ADMIN_USER=postgres
CAIRN_TEST_DATABASE_ADMIN_PASSWORD=a-remplacer
